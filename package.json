{
  "name": "tanstack-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "ruler:apply": "pnpm dlx @intellectronica/ruler@latest apply --local-only",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test:unit": "turbo test",
    "test": "pnpm test:template && pnpm test:integration",
    "test:content-surface": "pnpm --filter web build && pnpm check:brand-safety && node scripts/check-content-surface.mjs",
    "preview:backoffice": "BACKOFFICE_PREVIEW=1 node apps/server/scripts/preview-backoffice.mjs",
    "docs:facts-check": "node scripts/check-repository-facts.mjs && node scripts/check-module-feature-todo.mjs",
    "docs:todo-check": "node scripts/check-module-feature-todo.mjs",
    "check:expo-auth-compatibility": "node scripts/check-expo-auth-compatibility.mjs",
    "check:development-isolation": "node scripts/check-development-isolation.mjs",
    "check:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "check:brand-safety": "node scripts/check-brand-safety.mjs",
    "template:check-modifications": "node scripts/check-template-modifications.mjs",
    "template:audit-modifications": "pnpm template:check-modifications",
    "profiles:check": "node scripts/check-product-profiles.mjs",
    "profiles:build": "node scripts/build-profile-matrix.mjs",
    "check:wrangler-types": "node scripts/check-wrangler-types.mjs",
    "perf:bundle": "pnpm --filter web build && node scripts/analyze-web-bundle.mjs",
    "perf:homepage": "node scripts/measure-homepage-assets.mjs",
    "perf:budget": "node scripts/analyze-web-bundle.mjs && node scripts/measure-homepage-assets.mjs && node scripts/check-web-performance-budget.mjs && node scripts/check-public-config-leaks.mjs",
    "template:upgrade-check": "node scripts/template-upgrade-check.mjs",
    "verify:production-config": "pnpm --filter server preflight:production",
    "test:template": "pnpm docs:facts-check && pnpm check:boundaries && pnpm check:expo-auth-compatibility && pnpm check:development-isolation && pnpm template:check-modifications && pnpm profiles:check && pnpm check:wrangler-types && node --test scripts/check-module-feature-todo.test.mjs scripts/check-template-modifications.test.mjs scripts/check-architecture-boundaries.test.mjs scripts/check-content-surface-profile.test.mjs scripts/template-upgrade-check.test.mjs scripts/backoffice-preview-safety.test.mjs && node scripts/check-auto-merge-sha.mjs && pnpm --filter @repo/app-config test && pnpm --filter server test:config && pnpm --filter server test:production-config && pnpm --filter server exec tsx ../../scripts/check-security-headers.ts && pnpm test:content-surface",
    "test:integration": "turbo test:integration",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:web+server": "turbo -F web -F server dev",
    "mobile:dev": "pnpm --dir optional --filter mobile run dev",
    "mobile:check": "pnpm --dir optional --filter mobile run check",
    "mobile:lint": "pnpm --dir optional --filter mobile run lint",
    "mobile:doctor": "pnpm --dir optional --filter mobile run doctor",
    "mobile:ios-device": "pnpm --dir optional --filter mobile run dev:ios-device",
    "mobile:android-device": "pnpm --dir optional --filter mobile run dev:android-device",
    "mobile:eas:build:ios:production": "pnpm --dir optional --filter mobile run eas:build:ios:production",
    "mobile:eas:build:android:production": "pnpm --dir optional --filter mobile run eas:build:android:production",
    "db:studio": "turbo -F server db:studio",
    "db:studio:local": "turbo -F server db:studio:local",
    "db:generate": "turbo -F server db:generate",
    "db:check": "turbo -F server db:check",
    "db:migrate": "turbo -F server db:migrate",
    "db:migrate:local": "turbo -F server db:migrate:local",
    "db:migrate:production": "turbo -F server db:migrate:production",
    "module:check": "pnpm --filter server module:check",
    "db:studio:production": "turbo -F server db:studio:production",
    "deploy:web": "turbo -F web deploy",
    "deploy:server": "turbo -F server deploy",
    "deploy": "pnpm deploy:server && pnpm deploy:web",
    "husky:install": "husky install",
    "commit": "npx cz",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo && pnpm store prune"
  },
  "devDependencies": {
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm exec oxlint"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "maxHeaderWidth": 0,
      "maxLineWidth": 0
    }
  },
  "packageManager": "pnpm@11.13.1"
}
