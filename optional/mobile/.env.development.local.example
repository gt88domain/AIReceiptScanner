# Native development environment variables
# Usage:
# 1) cp .env.development.local.example .env.development.local
# 2) Fill real values in .env.development.local
# Expo public environment variables are bundled into the native app.

# Dev Server URL
# Used by native auth and API clients.
EXPO_PUBLIC_SERVER_API_URL=http://localhost:3001

# Dev Web App URL
# Used for opening web pages such as /terms and /privacy from the native app.
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000

# RevenueCat - https://www.easystarter.dev/zh/docs/mobile/integrations/iap/revenuecat
# Provider docs: https://www.revenuecat.com/docs/projects/authentication
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-revenuecat-android-key
# Entitlements docs: https://www.revenuecat.com/docs/entitlements
# Default entitlement id used by native paywall helpers.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# OpenPanel Analytics
# Provider console: https://openpanel.dev/docs/sdks/react-native
EXPO_PUBLIC_OPENPANEL_CLIENT_ID=your-openpanel-client-id
EXPO_PUBLIC_OPENPANEL_CLIENT_SECRET=your-openpanel-client-secret
