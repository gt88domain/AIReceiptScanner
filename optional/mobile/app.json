{
  "expo": {
    "name": "AI Receipt Scanner",
    "slug": "ai-receipt-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aireceiptscanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "YOUR_APPLE_TEAM_ID",
      "buildNumber": "1.0.0",
      "bundleIdentifier": "com.aireceiptscanner.app",
      "deploymentTarget": "16.4",
      "usesAppleSignIn": true,
      "icon": {
        "dark": "./assets/images/icon.png",
        "light": "./assets/images/icon.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan paper receipts on your device.",
        "NSPhotoLibraryUsageDescription": "Import receipt photos for on-device scanning."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aireceiptscanner.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to import receipt photos for on-device scanning."
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID"
    }
  }
}
