{
  "$schema": "./downstream-manifest.schema.json",
  "template": "easystarter-template",
  "upstream": {
    "repository": "https://github.com/gt88domain/easystarter-template",
    "release": "v0.1.0",
    "commit": "replace-with-the-release-commit"
  },
  "adoptedAt": "YYYY-MM-DD",
  "modifications": [
    {
      "path": "apps/server/src/modules/catalog",
      "ownership": "product",
      "reason": "Product catalog domain",
      "upstreamStrategy": "preserve"
    }
  ]
}
