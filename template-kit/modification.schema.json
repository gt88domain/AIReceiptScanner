{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyStarter protected-path modification",
  "type": "object",
  "required": ["id", "classification", "status", "paths", "owner", "reason", "evidence", "impact"],
  "properties": {
    "id": { "type": "string", "pattern": "^MOD-\\d{4}$" },
    "classification": { "enum": ["upstream-candidate", "product-specific", "temporary-workaround"] },
    "status": { "enum": ["active", "resolved"] },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "object", "required": ["tests"], "properties": { "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "impact": { "type": "object", "required": ["security", "data", "compatibility"], "properties": { "security": { "enum": ["none", "low", "medium", "high"] }, "data": { "enum": ["none", "low", "medium", "high"] }, "compatibility": { "enum": ["none", "low", "medium", "high"] } } }
  }
}
