{
  "name": "@repo/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./locale-path": {
      "types": "./src/locale-path.ts",
      "import": "./src/locale-path.ts"
    },
    "./locales": {
      "types": "./src/locales.ts",
      "import": "./src/locales.ts"
    },
    "./messages": {
      "types": "./src/messages/index.ts",
      "import": "./src/messages/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
