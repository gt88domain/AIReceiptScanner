{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanstack-template-web",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "demo.aiarticles.com",
      "custom_domain": true,
    },
  ],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "tanstack-template-server",
    },
  ],
  "vars": {
    "VITE_SERVER_URL": "https://api.demo.aiarticles.com",
    "VITE_APP_URL": "https://demo.aiarticles.com",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
