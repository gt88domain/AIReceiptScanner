{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "replace-web-worker",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "replace-domain.example",
      "custom_domain": true,
    },
  ],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "replace-api-worker",
    },
  ],
  "vars": {
    "VITE_SERVER_URL": "https://api.replace-domain.example",
    "VITE_APP_URL": "https://replace-domain.example",
    "VITE_TURNSTILE_SITE_KEY": "",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
