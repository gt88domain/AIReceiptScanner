# Web production environment variables
# Usage:
# 1) cp .env.production.example .env.production
# 2) Fill real values in .env.production
# VITE_ environment variables are exposed to the web client bundle.

# Production Server URL
# Used by web auth and API clients.
VITE_SERVER_URL=https://api.<production-domain>

# Production Frontend URL (for OAuth callbacks)
# Used as the public web app origin for auth callbacks, SEO, and sitemap generation.
VITE_APP_URL=https://<production-domain>

# Google Analytics
# Measurement ID docs: https://support.google.com/analytics/answer/12270356
VITE_GA_MEASUREMENT_ID=

# OpenPanel Analytics
# Provider docs: https://openpanel.dev/docs/sdks/web
VITE_OPENPANEL_CLIENT_ID=
