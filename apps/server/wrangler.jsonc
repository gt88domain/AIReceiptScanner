{
  "name": "your-worker-name",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.your-domain.example",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-d1-database-name",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "WEBSITE_URL": "https://your-domain.example",
    "SERVER_URL": "https://api.your-domain.example",
    // Add OAuth client IDs only after enabling the matching provider in app-config.
    "GITHUB_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "APPLE_APP_BUNDLE_IDENTIFIER": "",
  },
  "secrets": {
    "required": ["ADMIN_EMAILS", "BETTER_AUTH_SECRET"],
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "your-r2-bucket-name",
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
