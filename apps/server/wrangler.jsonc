{
  "name": "tanstack-template-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.demo.aiarticles.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easystarter-template-preview",
      "database_id": "d342a49e-68e3-46d1-a0f4-2f405bdf4c60",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "WEBSITE_URL": "https://demo.aiarticles.com",
    "SERVER_URL": "https://api.demo.aiarticles.com",
    // Add OAuth client IDs only after enabling the matching provider in app-config.
    "GITHUB_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "APPLE_APP_BUNDLE_IDENTIFIER": "",
  },
  "secrets": {
    "required": ["ADMIN_EMAILS", "BETTER_AUTH_SECRET"],
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "easysaas-bucket",
    },
  ],
  "triggers": {
    "crons": ["10 16 * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
