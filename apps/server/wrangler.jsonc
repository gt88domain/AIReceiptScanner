{
  "name": "easystarter-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easystarter-template-preview",
      "database_id": "d342a49e-68e3-46d1-a0f4-2f405bdf4c60",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "WEBSITE_URL": "https://easystarter-web.gt88hel.workers.dev",
    "SERVER_URL": "https://easystarter-server.gt88hel.workers.dev",
    // Add non-sensitive public IDs here:
    // GitHub OAuth client ID
    "GITHUB_CLIENT_ID": "Ov23liJZZtODJ0YsClHs",
    // Google OAuth client ID
    "GOOGLE_CLIENT_ID": "895860292632-mt94ccat279506bmk2n59s8c4evt87me.apps.googleusercontent.com",
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "easysaas-bucket",
    },
  ],
  "triggers": {
    "crons": ["10 16 * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
