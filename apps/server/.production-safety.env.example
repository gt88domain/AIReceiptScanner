# Explicitly identify the production resources this checkout is allowed to deploy to.
# This file stays local so a staging resource cannot become production by changing
# wrangler.jsonc alone.
EXPECTED_WORKER_NAME=
EXPECTED_D1_DATABASE_ID=
EXPECTED_R2_BUCKET=
EXPECTED_WEBSITE_URL=https://your-app.example.com
EXPECTED_SERVER_URL=https://api.your-app.example.com
