# Worker runtime secrets for Wrangler secret bulk.
# Usage:
# 1) cp .env.production.example .dev.vars.production
# 2) Fill runtime secrets in .dev.vars.production
# 3) pnpm run secrets:bulk:production
# TanStack Template documentation: https://demo.aiarticles.com/docs
# Public production URLs and OAuth client IDs belong in apps/server/wrangler.jsonc vars.

# This must remain production. Resource identities must exactly match
# .production-safety.env and wrangler.jsonc before deployment.
ENVIRONMENT=production
WORKER_NAME=
D1_DATABASE_ID=
R2_BUCKET=
QUEUE_NAME=

# Better Auth - https://demo.aiarticles.com/docs
# Provider docs: https://better-auth.com/docs/installation
BETTER_AUTH_SECRET=

# Administrator access - comma-separated emails, deployed only as a Worker secret.
# Do not add this to wrangler.jsonc vars or any VITE_ variable.
ADMIN_EMAILS=

# Github OAuth - https://demo.aiarticles.com/docs
# Provider console: https://github.com/settings/developers
GITHUB_CLIENT_SECRET=

# Google OAuth - https://demo.aiarticles.com/docs
# Provider console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=

# Apple OAuth / Sign in with Apple (native idToken flow)
# Docs:
# - https://docs.expo.dev/versions/latest/sdk/apple-authentication/
# Native iOS bundle id (example: com.example.app), should match app.json ios.bundleIdentifier
APPLE_APP_BUNDLE_IDENTIFIER=

# Resend Email - https://demo.aiarticles.com/docs
# Provider console: https://resend.com/api-keys
RESEND_API_KEY=

# R2 Storage - https://demo.aiarticles.com/docs
# Public URL for accessing R2 stored files (e.g., https://pub-xxx.r2.dev or your custom domain)
R2_PUBLIC_URL=

# Alibaba Cloud Dypnsapi - https://demo.aiarticles.com/docs
# Provider docs: https://help.aliyun.com/zh/pnvs/developer-reference/api-dypnsapi-2017-05-25-sendsmsverifycode
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Aliyun OSS Storage - https://help.aliyun.com/zh/oss/
# Set common.storage.provider to "aliyun-oss" in packages/app-config/src/app-config.ts to use it.
# Reuses ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET above.
# Endpoint should not include the bucket name, e.g. oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=

# Stripe - https://demo.aiarticles.com/docs
# Provider docs: https://stripe.com/docs/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Creem - https://demo.aiarticles.com/docs
# Provider docs: https://docs.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Waffo Pancake - https://docs.waffo.ai/zh/integrate/skill
# Provider dashboard: https://pancake.waffo.ai/merchant/dashboard/integration
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=prod

# RevenueCat - https://demo.aiarticles.com/docs
# Provider docs: https://demo.aiarticles.com/docs
REVENUECAT_WEBHOOK_SECRET=
